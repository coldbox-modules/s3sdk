{
    "name":"s3sdk-boxlang@1",
    "app":{
        "cfengine":"boxlang@1",
        "serverHomeDirectory":".engine/boxlang1"
    },
    "force":true,
    "openBrowser":false,
    "web":{
        "directoryBrowsing":true,
        "http":{
            "port":"60299"
        },
        "rewrites":{
            "enable":"true"
        },
        "webroot":"test-harness",
        "aliases":{
            "/moduleroot/s3sdk":"./"
        }
    },
    "JVM":{
        "heapSize":"1024",
        "javaVersion":"openjdk21_jre"
    },
    "cfconfig":{
        "file":".cfconfig.json"
    },
    "scripts":{
        "onServerInitialInstall":"install bx-esapi --noSave"
    }
}
